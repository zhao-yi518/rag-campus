# ============================================================
# 环境变量模板：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传）
# ============================================================

# 阿里云百炼（DashScope）OpenAI 兼容接口密钥 —— 驱动问答生成
# 获取方式：https://bailian.console.aliyun.com/ -> API-KEY 管理 -> 创建
# 注意：这是付费/限流密钥，切勿提交到 Git 仓库
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 大模型服务地址（OpenAI 兼容模式，qwen 系列）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 使用的模型名称（qwen-plus 为性价比推荐，可换 qwen-turbo/qwen-max）
LLM_MODEL=qwen-plus

# 服务监听端口
PORT=3000

# 管理员口令（首次启动时自动创建 developer 开发者账号使用；
# 之后登录鉴权全部走账号体系，此变量仅用于初始化）
ADMIN_PASSWORD=校园助手2026